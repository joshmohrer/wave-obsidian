{
	"name": "wave-ai-obsidian",
	"version": "1.0.5",
	"description": "Wave AI plugin for Obsidian: sync your recordings into your vault as Markdown.",
	"main": "main.js",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --import tsx --test 'test/*.test.ts'",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"wave",
		"wave-ai",
		"meeting-notes",
		"transcripts"
	],
	"author": "Wave AI",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.0.0",
		"esbuild": "^0.25.0",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "^1.14.4",
		"tslib": "^2.8.1",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"typescript-eslint": "^8.72.1"
	}
}
